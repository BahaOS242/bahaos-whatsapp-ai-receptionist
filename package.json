{
  "name": "bahaos-whatsapp-ai-receptionist",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant WhatsApp AI receptionist for dental practices (BahaOS).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.mts",
    "chat": "tsx scripts/dev-chat.ts",
    "eval": "tsx scripts/run-eval.ts",
    "eval:llm": "tsx scripts/eval-llm-comparison/cli.ts",
    "eval:llm:compare": "tsx scripts/eval-llm-comparison/cli.ts --compare",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "knowledge": "tsx scripts/knowledge.ts",
    "worker": "node dist/worker.js",
    "jobs": "tsx scripts/jobs.ts",
    "chat:web": "tsx scripts/local-chat/server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@google/genai": "^2.18.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "googleapis": "^176.0.0",
    "openai": "^7.5.0",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
