# Copy this file to .env and fill in local values. Never commit .env.
# Phase 1 only reads the variables in the first section below — the app
# validates and needs ONLY these to start locally. Everything after that
# is a documented placeholder for later phases; it is not read by any
# code yet and must not be filled in with real credentials until that
# phase is explicitly authorized (see PROJECT_CONTEXT.md and
# IMPLEMENTATION_PLAN.md).

# --- Phase 1: required to run the app locally -------------------------

# Postgres connection string, e.g. postgres://user:password@localhost:5432/bahaos
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bahaos_dev

# development | test | production
NODE_ENV=development

# Port the HTTP server listens on
PORT=3000

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Phase 4: AI receptionist — optional -------------------------------
# Leave ANTHROPIC_API_KEY unset to use DevRuleBasedAIProvider
# (deterministic, no network, no key). ANTHROPIC_API_KEY is the ONLY
# credential createAiProvider() (src/ai/create-provider.ts) reads —
# Anthropic is a standing, explicit project constraint, not an
# implementation preference. OPENAI_API_KEY/OPENROUTER_API_KEY/
# GEMINI_API_KEY below are accepted by env validation and their client
# files still work, but provider SELECTION ignores all three and must
# never be changed to use them. Never commit a real key here — this file
# only ships placeholders.

# Your Anthropic API key — the ACTIVE LLM provider. Unset =
# DevRuleBasedAIProvider is used instead.
# ANTHROPIC_API_KEY=

# Defaults to claude-haiku-4-5-20251001 (fast/cheap) if unset.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Your OpenAI API key. Not used for provider selection (see above) — kept
# for OpenAiChatClient's own tests only. Do not re-enable.
# OPENAI_API_KEY=

# Defaults to gpt-4o-mini if unset. Verify this model name is still
# current/available before relying on it — check platform.openai.com.
OPENAI_MODEL=gpt-4o-mini

# Your Gemini API key. Not used for provider selection. Do not re-enable.
# GEMINI_API_KEY=

# Defaults to gemini-2.5-flash (fast/cheap) if unset. Verify this model
# name is still current/available before relying on it — check
# ai.google.dev.
GEMINI_MODEL=gemini-2.5-flash

# Your OpenRouter API key. Not used for provider selection. Do not
# re-enable — Anthropic is the only permitted LLM provider for this
# project.
# OPENROUTER_API_KEY=

# Defaults to openrouter/free if unset. Verify this model slug is still
# current/available before relying on it — check openrouter.ai/models.
OPENROUTER_MODEL=openrouter/free

# --- Phase 6: real database-backed booking — optional -------------------
# Set to "true" to switch the app to createDatabaseReceptionistTools
# (src/tools/database-receptionist-tools.ts) — the real,
# concurrency-safe Postgres booking path (exclusion-constraint-protected,
# see src/db/appointments.ts). Requires DATABASE_URL to point at a
# database with this project's migrations applied (drizzle/0000...,
# 0001..., 0002...). Takes priority over the Google Calendar tools below
# when both are configured. Deliberately explicit opt-in — DATABASE_URL
# alone is not enough, since it's always required for other reasons and
# its mere presence doesn't imply the booking migrations were run.
# DB_BOOKING_ENABLED=true

# --- Phase 5: Google Calendar booking — optional -----------------------
# Leave unset to use createSimulatedReceptionistTools (in-memory, no
# network). Setting all four switches the app to
# createGoogleCalendarReceptionistTools
# (src/tools/google-calendar-receptionist-tools.ts), which reads/writes a
# real Google Calendar. Never commit real values here — this file only
# ships placeholders. Single demo tenant only; not multi-tenant OAuth.

# OAuth2 client credentials for the calendar-owning Google account.
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# A refresh token obtained once via the OAuth consent flow for that
# account/calendar — not a short-lived access token.
# GOOGLE_CALENDAR_REFRESH_TOKEN=
# The calendar ID to read/write, e.g. the account's email address for its
# primary calendar, or a dedicated calendar's ID from its settings.
# GOOGLE_CALENDAR_ID=

# --- WhatsApp Cloud API webhook — optional -----------------------------
# All four are optional, matching GOOGLE_CALENDAR_*'s pattern above — the
# webhook route (src/routes/whatsapp-webhook.ts) is always mounted, but
# npm test/npm run test:db/npm run chat never require any of these; a
# mock in-memory transport (src/messaging/mock-messaging-provider.ts) is
# used for outbound sending whenever the access token + phone number id
# aren't both configured. Never commit real values here.

# Meta app secret — enables X-Hub-Signature-256 verification of inbound
# webhook payloads. Without it, signature verification is skipped
# entirely (logged as a known, explicit gap, not silently pretended away
# — see whatsapp-webhook.ts's PHASE 13 note).
# WHATSAPP_APP_SECRET=

# The token YOU choose and configure in the Meta app dashboard's webhook
# subscription screen — required for the GET verification handshake to
# ever succeed.
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Cloud API access token + the business phone number's id — both
# required together to enable REAL outbound sending
# (src/messaging/whatsapp-messaging-provider.ts). Leave unset to use the
# mock transport.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Graph API version segment. Defaults to v21.0 if unset — verify this is
# still current before relying on it in production.
WHATSAPP_API_VERSION=v21.0

# Phase 7 — Staff dashboard auth / email notifications
# ADMIN_SESSION_SECRET=
# SMTP_URL=
# STAFF_NOTIFICATION_EMAIL_FROM=

# Phase 8 — Railway deployment
# (Railway injects its own runtime env vars; nothing to declare here yet.)

# --- Business knowledge / RAG engine (see KNOWLEDGE_ENGINE.md) ----------------
# Opt-in. Requires migration 0007 (drizzle/0007_knowledge_engine.sql) when
# DB_BOOKING_ENABLED=true. Off => behavior is identical to before the engine.
KNOWLEDGE_ENABLED=false
# Optional: real embeddings via Voyage AI. Absent => offline hashing embedder
# (no network, no credentials). Never commit a real key.
# VOYAGE_API_KEY=
# VOYAGE_EMBEDDING_MODEL=voyage-3.5-lite

# --- Customer & conversation memory (see MEMORY_ENGINE.md) ---------------------
# Opt-in. Requires migration 0011 (drizzle/0011_customer_memory.sql). Off => no
# extraction, no retrieval, no prompt change: behavior identical to Phase 3.
MEMORY_ENABLED=false
